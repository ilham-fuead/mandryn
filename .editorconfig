root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,json,yml,yaml,html,vue,js,css}]
indent_size = 2

[*.{wav,mp3,png,jpg,jpeg,gif,ico,webp,zip}]
insert_final_newline = false
trim_trailing_whitespace = false
