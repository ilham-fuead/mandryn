    "minimum-stability": "stable",
    "prefer-stable": true,
    "support": {
        "email": "ilham.fuead@gmail.com",
        "issues": "https://github.com/ilham-fuead/mandryn/issues",
        "source": "https://github.com/ilham-fuead/mandryn"
    },
    "require": {
        "php": ">=8.3.6",
        "guzzlehttp/guzzle": "^7.8 || ^8.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpunit/php-timer": "^6.0",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Mandryn\\db\\": "src/db/",
            "Mandryn\\db\\constant\\": "src/db/constant/",
            "Mandryn\\http\\": "src/http/",
            "Mandryn\\Mcp\\": "src/mcp/"
        },
        "classmap": [
            "src/mandryn_v1/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/mandryn-mcp"
    ],
    "scripts": {
        "test": "@php vendor/bin/phpunit",
        "analyse": [
            "@php vendor/bin/phpstan analyse -c phpstan.neon.dist --no-progress",
            "@php vendor/bin/phpstan analyse -c phpstan.legacy.neon --no-progress"
        ]
    },
    "config": {
        "sort-packages": true
    }
}
